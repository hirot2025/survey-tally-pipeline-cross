# ============================================================
# クロス集計の公開用フォルダ(許可リストで作ったもの)用の .gitignore
# 登録するのは スクリプト・公開版 080・ダミー・sample だけ。実行で作られるものは除外する。
# ============================================================

# --- 実データの名前のファイル(ダミーをこの名前で置いて動かすため、必ず除外) ---
*_real.csv
*_real_*.csv
*_real_*.xlsx

# --- 実行で作られる入力・出力(先頭の / で、いちばん上の階層だけを指す) ---
/000_ja100_cross/
/010_ja100_csv_cross/
/011_ja100_csv_formatted_cross/
/020_ja100_step1_merge_cross/
/050_*.csv
/051_*.csv
/051_*.txt
/052_*.xlsx
/053_*.xlsx
/*batch_processing_cross_*.csv

# --- Word・PDF・Office の一時ファイル ---
*.docx
*.pdf
~$*
*.partial

# --- 診断用などのスクリプト ---
099_*.py
100_*.py
101_*.py
102_*.py

# --- Python・エディタ・OS・ログ ---
__pycache__/
*.pyc
.venv/
venv/
logs/
*.log
*.tmp
.vscode/
.idea/
.DS_Store
Thumbs.db
